# Absolute public backend API URL; browser requests are sent directly (no Next.js proxy).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api
# Public build-time tenant selector sent as X-Equestrian-Service-Key; not a CMS credential.
NEXT_PUBLIC_EQUESTRIAN_SERVICE_KEY=default-equestrian
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_RELEASE=
